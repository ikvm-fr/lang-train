{
  "name": "lang-train",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:player": "npm run dev -w @lang-train/player",
    "dev:editor": "npm run dev -w @lang-train/editor",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @lang-train/player && npm run build -w @lang-train/editor && node scripts/assemble.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
